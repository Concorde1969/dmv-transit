# Caddy obtains and renews HTTPS certificates for SITE_DOMAIN automatically
# (DNS must already point at this server, and ports 80 + 443 must be open).
{
	email {$ACME_EMAIL}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	request_body {
		max_size 16KB
	}

	# Compress everything except the streamed chat answers (compression buffers them)
	# and the basemap (already compressed; the map reads it in byte ranges).
	@compressible not path /api/chat /tiles/*
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Location: only this site may ask (to find stops near the rider).
		Permissions-Policy "geolocation=(self), microphone=(), camera=()"
		# Everything is served from this site. The map engine runs its worker from a
		# blob: URL and draws icons into blob:/data: images.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	reverse_proxy app:8765 {
		# Send each piece of a streamed answer immediately.
		flush_interval -1
	}

	# Access log with visitor addresses masked to their network (e.g. 203.0.0.0/16):
	# the site promises not to keep IP addresses.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>headers>X-Forwarded-For delete
			}
		}
	}
}
