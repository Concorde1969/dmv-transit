# ============================================================================
#  DMV Regional Transportation Assistant — server settings
#  Copy to .env in the project folder on the server and fill in the first block.
#  Keep this file private:  chmod 600 .env
# ============================================================================

# --- Required ----------------------------------------------------------------
SITE_DOMAIN=dmvtransit.com
# Let's Encrypt sends certificate-expiry notices here.
ACME_EMAIL=
# https://console.anthropic.com/  — ALSO set a monthly spend limit there.
ANTHROPIC_API_KEY=
# https://developer.wmata.com/ (free)
WMATA_API_KEY=
# https://www.transit.land/ — live departures on the map (Explorer plan: 5,000 calls/month)
TRANSITLAND_API_KEY=
TRANSITLAND_MONTHLY_BUDGET=4500
# Address search on the map (used server-side only): Google's Geocoding API when set,
# capped at GOOGLE_GEOCODING_MONTHLY_BUDGET requests a month; else geocode.maps.co.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_MONTHLY_BUDGET=9000
# Suggestions while typing: Google Places Autocomplete with the same key (enable
# "Places API (New)" for it), capped at this many requests a month.
GOOGLE_PLACES_MONTHLY_BUDGET=9000
GEOCODE_API_KEY=

# --- Accounts: saved hotel, home and places to visit ----------------------------
# Sign-in codes are emailed through Amazon SES (SMTP). Create SMTP credentials in the
# SES console (selected Region), and verify the sending domain first (deploy/README.md).
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=DMV Transit <signin@dmvtransit.com>
ACCOUNTS_ENABLED=true
# Sign-in emails the whole site may send a day; accounts unused this long are deleted.
ACCOUNTS_DAILY_EMAILS=500
ACCOUNTS_INACTIVE_DAYS=730

# --- MCP server for other LLMs (https://SITE_DOMAIN/mcp) --------------------------
# Requests each API key may make.
MCP_RATE_PER_MINUTE=30
MCP_RATE_PER_DAY=300

# --- Model ---------------------------------------------------------------------
# Leave commented to use the app's default model.
#ANTHROPIC_MODEL=

# --- Cost / abuse limits for the public site ------------------------------------
# Per visitor (by IP address)
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_DAY=60
# Whole site, per day (resets at midnight Eastern). Main cost ceiling in the app.
CHAT_DAILY_LIMIT=1500
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_MAX_TURNS=20
CHAT_HISTORY_TURNS=6

# --- Chat log (questions, answers and diagnostics, for review) -------------------
# Saved in CHATLOG_DB; visitors get an anonymous ID, never their IP address.
CHATLOG_ENABLED=true
CHATLOG_RETENTION_DAYS=365
# Remove email addresses, phone numbers and long numbers before saving.
CHATLOG_REDACT=true

# --- Data refresh ----------------------------------------------------------------
REFRESH_ALERTS_MINUTES=15
REFRESH_FULL_AT=03:30
TIMEZONE=America/New_York

# --- Identify ourselves politely to the agencies' websites -----------------------
HTTP_USER_AGENT=DMVTransitAssistant/1.0 (+https://dmvtransit.com)

# --- Optional: your own scheduling engine (see docs/EXTENDING.md) ----------------
# For a Node engine, also build the image with Node:
#   docker compose build --build-arg WITH_NODE=true
#PLANNER_ENGINE=process
#PLANNER_COMMAND=node engines/my-engine/engine.js
