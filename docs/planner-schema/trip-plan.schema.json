        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "Leg",
      "type": "object"
    },
    "TripOption": {
      "additionalProperties": true,
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/Leg"
          },
          "title": "Legs",
          "type": "array"
        },
        "transfers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transfers"
        },
        "feasible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Does this work on the requested day/time?",
          "title": "Feasible"
        },
        "feasibility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plain-language reason, e.g. 'works Mon\u2013Fri'.",
          "title": "Feasibility"
        },
        "depart_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depart Time"
        },
        "arrive_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrive Time"
        },
        "duration_min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Min"
        },
        "walk_min_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walk Min Total"
        },
        "total_fare": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Fare"
        },
        "total_cost_estimate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Cost Estimate"
        }
      },
      "required": [
        "summary"
      ],
      "title": "TripOption",
      "type": "object"
    }
  },
  "properties": {
    "contract_version": {
      "default": "1",
      "title": "Contract Version",
      "type": "string"
    },
    "engine": {
      "default": "external",
      "title": "Engine",
      "type": "string"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "day": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/TripOption"
      },
      "title": "Options",
      "type": "array"
    },
    "caveat": {
      "default": "Guidance only \u2014 confirm departure times and fares with each agency before travelling.",
      "title": "Caveat",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "data_stale": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Stale"
    }
  },
  "required": [
    "origin",
    "destination"
  ],
  "title": "TripPlan",
  "type": "object"
}