# ============================================================================
#  DMV Regional Transportation Assistant — settings
#  The two keys below are all most people need to fill in.
# ============================================================================

# Needed for the chat assistant. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Needed for Metro schedules (WMATA's GTFS feeds), live alerts, elevator status and
# station fares. Free at https://developer.wmata.com/ ("Default Tier" product).
WMATA_API_KEY=

# Transitland (https://www.transit.land/): live departures on the map. Schedules come
# from GTFS feeds found through Transitland's public registry and need no key.
# Every API call counts against TRANSITLAND_MONTHLY_BUDGET (Explorer plan: 5,000).
TRANSITLAND_API_KEY=
#TRANSITLAND_MONTHLY_BUDGET=4500

# Address search on the map (server-side only). Google's Geocoding API is used when
# GOOGLE_GEOCODING_API_KEY is set (console.cloud.google.com: enable "Geocoding API";
# restrict the key to that API and to the server's IP address). It's billed per
# request, so the app stops at GOOGLE_GEOCODING_MONTHLY_BUDGET requests a month.
GOOGLE_GEOCODING_API_KEY=
#GOOGLE_GEOCODING_MONTHLY_BUDGET=9000
# Fallback when there's no Google key: geocode.maps.co.
GEOCODE_API_KEY=

# Leave-now planner on the map
#TRIP_MAX_WALK_M=1600
#TRIP_STOPS_PER_AGENCY=25
#TRIP_WINDOW_MIN=180
#TRIP_SHORT_TRANSFER_MIN=10
#TRIP_MAX_TRANSFER_WAIT_MIN=120
#TRIP_MAX_LIVE_CALLS=6
#MAP_TILES_PATH=./data/map/dmv.pmtiles


# ---------------------------------------------------------------------------
#  Everything below is optional. The defaults work.
#  (Running the public website on a server? Use deploy/.env.production.example.)
# ---------------------------------------------------------------------------

# --- Chat --------------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5
CHAT_MAX_TOKENS=2048
CHAT_HOST=127.0.0.1
CHAT_PORT=8765

# --- Chat log -----------------------------------------------------------------
# Every question, answer and its diagnostics are saved here for review
# (`transit-mcp chatlog export|stats|delete`). Visitors get an anonymous ID, never
# their IP address; emails/phone numbers are removed. Kept CHATLOG_RETENTION_DAYS.
#CHATLOG_ENABLED=true
#CHATLOG_DB=./chatlog.db
#CHATLOG_RETENTION_DAYS=365
#CHATLOG_REDACT=true

# --- Rider reports ------------------------------------------------------------
# Riders' reports of delays and problems, checked by a small Claude model before others
# see them. Shown on matching trips for REPORTS_SHOW_HOURS.
#REPORTS_ENABLED=true
#REPORTS_MODEL=claude-haiku-5-5
#REPORTS_SHOW_HOURS=3
#REPORTS_RETENTION_DAYS=365
#REPORTS_RATE_PER_DAY=10
#REPORTS_DAILY_LIMIT=300

# --- Agencies ------------------------------------------------------------------
# Extra agency definition files (add or override built-ins by slug).
# See agencies/README.md.
AGENCIES_DIR=./agencies

# --- Storage -----------------------------------------------------------------
TRANSIT_MCP_DB=./transit.db
TRANSIT_MCP_CACHE_DIR=./.cache
# Raw GTFS zips from every ingest are kept here for scheduling engines.
GTFS_ARCHIVE_DIR=./data/gtfs
# Manually-downloaded feeds: feeds/<slug>/google_transit.zip (VRE, CUE).
FEEDS_DIR=./feeds

# --- Trip planning / scheduling engine (see docs/EXTENDING.md) --------------
# heuristic = built-in advisor | python | process | http
PLANNER_ENGINE=heuristic
# python:  module:factory or path/to/engine.py:factory
#PLANNER_PYTHON=engines/example_python/engine.py:create
# process: a long-running command speaking JSON lines on stdin/stdout
#PLANNER_COMMAND=node engines/example-js/engine.js
# http:    base URL serving POST /plan and GET /describe
#PLANNER_URL=http://127.0.0.1:9000
PLANNER_TIMEOUT_SECONDS=20
# If your engine fails, answer with the built-in advisor instead (with a warning).
PLANNER_FALLBACK=true

# --- Data loading ----------------------------------------------------------------
# false = skip GTFS stop_times.txt (much faster; loses departure-time detail).
GTFS_LOAD_STOP_TIMES=true
# Two stops within this many meters count as a walkable transfer.
TRANSFER_LINK_RADIUS_M=250
NEARBY_SEARCH_RADIUS_M=400
WALK_SPEED_M_PER_MIN=80
# Retrieval flags data older than this many hours as possibly stale.
STALE_AFTER_HOURS=24

# --- Crawl politeness ------------------------------------------------------------
CRAWL_DELAY_SECONDS=1.0
HTTP_USER_AGENT=transit-mcp/0.1 (+https://github.com/your-org/transit-mcp)
