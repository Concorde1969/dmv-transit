# ============================================================================
#  DMV Regional Transportation Assistant — settings
#  The two keys below are all most people need to fill in.
# ============================================================================

# Needed for the chat assistant. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Needed for live Metro alerts, elevator status and station fares. Free at
# https://developer.wmata.com/ (subscribe to the "Default Tier" product).
WMATA_API_KEY=


# ---------------------------------------------------------------------------
#  Everything below is optional. The defaults work.
#  (Running the public website on a server? Use deploy/.env.production.example.)
# ---------------------------------------------------------------------------

# --- Chat --------------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5
CHAT_MAX_TOKENS=2048
CHAT_HOST=127.0.0.1
CHAT_PORT=8765

# --- Agencies ------------------------------------------------------------------
# Extra agency definition files (add or override built-ins by slug).
# See agencies/README.md.
AGENCIES_DIR=./agencies

# --- Storage -----------------------------------------------------------------
TRANSIT_MCP_DB=./transit.db
TRANSIT_MCP_CACHE_DIR=./.cache
# Raw GTFS zips from every ingest are kept here for scheduling engines.
GTFS_ARCHIVE_DIR=./data/gtfs
# Manually-downloaded feeds: feeds/<slug>/google_transit.zip (VRE, CUE).
FEEDS_DIR=./feeds

# --- Trip planning / scheduling engine (see docs/EXTENDING.md) --------------
# heuristic = built-in advisor | python | process | http
PLANNER_ENGINE=heuristic
# python:  module:factory or path/to/engine.py:factory
#PLANNER_PYTHON=engines/example_python/engine.py:create
# process: a long-running command speaking JSON lines on stdin/stdout
#PLANNER_COMMAND=node engines/example-js/engine.js
# http:    base URL serving POST /plan and GET /describe
#PLANNER_URL=http://127.0.0.1:9000
PLANNER_TIMEOUT_SECONDS=20
# If your engine fails, answer with the built-in advisor instead (with a warning).
PLANNER_FALLBACK=true

# --- Data loading ----------------------------------------------------------------
# false = skip GTFS stop_times.txt (much faster; loses departure-time detail).
GTFS_LOAD_STOP_TIMES=true
# Two stops within this many meters count as a walkable transfer.
TRANSFER_LINK_RADIUS_M=250
NEARBY_SEARCH_RADIUS_M=400
WALK_SPEED_M_PER_MIN=80
# Retrieval flags data older than this many hours as possibly stale.
STALE_AFTER_HOURS=24

# --- Crawl politeness ------------------------------------------------------------
CRAWL_DELAY_SECONDS=1.0
HTTP_USER_AGENT=transit-mcp/0.1 (+https://github.com/your-org/transit-mcp)
